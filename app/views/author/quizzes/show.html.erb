<%= render "shared/breadcrumbs" %>
<div class="grid gap-3 md:grid-cols-3 md:grid-rows-2">
  <div class="col-span-1 row-span-1">
    <%= render "shared/resource_card",
              object: @quiz,
              edit_path: edit_author_quiz_path(@quiz),
              item_count: @quiz.questions.count,
              item_name: "questions" %>
  </div>
  <div class="md:col-span-1 md:row-start-2 md:row-span-1">
    <div class="flex flex-col p-2 space-y-4 border border-gray-500 rounded">
      <%= form_with model: @quiz, url: publish_author_quiz_path(@quiz), method: :patch do |f| %>
        <details class="mb-6 border-b border-gray-500" open>
          <summary class="flex items-center mb-2 text-2xl"><%= render_icon "cog-6-tooth", klass: "size-8" %>
            <span class="ml-2">Settings</span></summary>
        </details>
        <label class="relative flex items-center mb-4 cursor-pointer">
          <%= f.check_box :publish, checked: @quiz.published?, class: "sr-only peer" %>
          <div
            class="
              w-11 h-6 bg-gray-400 rounded-full peer-focus:ring-4 peer-focus:ring-blue-300
              peer-checked:bg-blue-600 after:content-[''] after:absolute after:top-[2px]
              after:left-[2px] after:bg-white after:border after:rounded-full after:h-5
              after:w-5 after:transition-all peer-checked:after:translate-x-full
            "></div>
          <span class="ml-3 text-sm font-medium">
            Publish
          </span>
        </label>
        <%= f.submit t("buttons.quizzes.settings"), class: "btn btn-success" %>
      <% end %>
    </div>
  </div>
  <section data-controller="search-filter" class="flex flex-col px-2 py-1 bg-gray-800 rounded md:col-span-2 md:row-span-2">
    <div class="flex flex-col items-center justify-between py-2 mb-2 border-b border-gray-500 md:inline-flex md:flex-row">
      <form class="flex-1 mr-3 md:w-auto">
        <label for="search" class="mb-2 text-sm font-medium text-gray-900 sr-only dark:text-white">Search Questions</label>
        <div class="relative">
          <div class="absolute inset-y-0 flex items-center pointer-events-none start-0 ps-3">
            <svg class="w-4 h-4 text-gray-500 dark:text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z" />
            </svg>
          </div>
          <%= search_field_tag :search, nil,
              data: {
                  "search-filter-target": "input",
                  action: "input->search-filter#onInput"
              },
              autocomplete: "on",
              class: "block w-full p-2 ps-10 text-sm text-gray-900 border border-gray-300 rounded-lg bg-gray-50 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500",
              placeholder: "Search questions" %>
        </div>
      </form>
      <%= link_to new_quiz_question_path(@quiz), class: "flex self-end btn hover:btn-success transition ease-in-out duration-500" do %>
        <%= render_icon "plus" %>
        <span class="ml-2">Add Question</span>
      <% end %>
    </div>
    <div data-search-filter-target="itemContainer" class="max-h-[650px] h-full">
      <p data-search-filter-target="emptyMessage" class="hidden w-full mb-2 text-xl italic text-center text-gray-500">No questions found - try a different search.</p>
      <% if @quiz.questions.exists? %>
        <ul id="questionsList" class="flex flex-col gap-1 pr-6">
          <%= render partial: "question", collection: @quiz.questions, locals: { quiz: @quiz } %>
        </ul>
      <% else %>
        <div id="no-questions-instructions" class="flex flex-col w-full h-full pt-4 justify-self-center">
          <h3 class="w-full mb-2 text-xl italic text-center text-gray-500">No questions available</h3>
          <p class="items-center text-center text-gray-500 text-balance">
            You can add questions to your quiz using <br>
            the <span class="italic font-semibold text-white">Add Question</span> button above.</p>
        </div>
      <% end %>
    </div>
  </section>
</div>
