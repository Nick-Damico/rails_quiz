<%= render "shared/breadcrumbs" %>
<div class="flex flex-col space-y-2 md:flex-row md:space-y-0 md:space-x-2">
  <div class="md:w-1/3">
    <%= render "shared/resource_card",
              object: @deck,
              edit_path: edit_author_deck_path(@deck),
              item_count: @deck.cards.count,
              item_name: "cards" %>
  </div>
  <section data-controller="search-filter" class="flex flex-col w-full px-2 py-4 bg-gray-800 rounded md:w-2/3">
    <%= link_to new_deck_card_path(deck_id: @deck.id), class: "flex btn rounded ml-auto hover:btn-success transition ease-in-out duration-500" do %>
      <%= render_icon "plus" %>
      <span class="ml-2">Add Flashcard</span>
    <% end %>
    <div class="flex flex-col items-center justify-between py-2 mb-2 border-b border-gray-500 md:inline-flex md:flex-row">
      <h2 class="mb-1 text-2xl md:mb-0">
        Flashcards
      </h2>
      <form class="w-full md:w-auto">
        <label for="search" class="mb-2 text-sm font-medium text-gray-900 sr-only dark:text-white">Search</label>
        <div class="relative">
          <div class="absolute inset-y-0 flex items-center pointer-events-none start-0 ps-3">
            <svg class="w-4 h-4 text-gray-500 dark:text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z" />
            </svg>
          </div>
          <%= search_field_tag :search, nil,
              data: {
                  "search-filter-target": "input",
                  action: "input->search-filter#onInput"
              },
              autocomplete: "on",
              class: "block w-full p-2 ps-10 text-sm text-gray-900 border border-gray-300 rounded-lg bg-gray-50 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500",
              placeholder: "Search" %>
        </div>
      </form>
    </div>
    <div class="max-h-[650px] h-full overflow-auto">
      <p data-search-filter-target="emptyMessage" class="hidden w-full mb-2 text-xl italic text-center text-gray-500">No Cards found - try a different search.</p>
      <% if @deck.cards.exists? %>
        <ul id="cards_list" class="flex flex-col gap-1 pr-6">
          <%= render partial: "card_list_item", collection: @deck.cards, as: "card" %>
        </ul>
      <% else %>
        <div id="no-questions-instructions" class="flex flex-col w-full h-full pt-4 justify-self-center">
          <h3 class="w-full mb-2 text-xl italic text-center text-gray-500">No flashcards available</h3>
          <p class="items-center text-center text-gray-500 text-balance">
            You can add flashcards to your deck using <br>
            the <span class="italic font-semibold text-white">Add Flashcard</span> button above.</p>
        </div>
      <% end %>
    </div>
  </section>
</div>
