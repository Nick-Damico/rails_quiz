<%= render "shared/breadcrumbs" %>
<div class="flex flex-col space-y-2 md:space-y-2 w-full lg:w-1/2 max-w-[600px]">
  <%= render "shared/display_card", object: @deck, collection_method: :cards %>
  <div
    data-controller="decks--review-settings"
    class="flex flex-col p-4 space-y-4 border border-gray-500 rounded">
    <%= form_with model: @user_deck, url: user_decks_path, method: :post do |f| %>
      <%= f.hidden_field :deck_id, value: @user_deck.deck_id %>
      <%= f.hidden_field :user_id, value: @user_deck.user_id %>
      <details class="pb-2 mb-6 border-b border-gray-500" open>
        <summary class="flex items-center mb-4 text-2xl"><%= render_icon "cog-6-tooth", klass: "size-8" %>
          <span class="ml-2">Settings</span></summary>
        <label class="relative inline-flex items-center cursor-pointer">
          <%= f.check_box :use_space_repetition,
                      class: "sr-only peer",
                      data: {
                        "action" =>
                          "change->decks--review-settings#toggleSpaceRepetition",
                        "decks--review-settings-target" => "spaceRepetitionCheckbox",
                      } %>
          <div
            class="
              w-11 h-6 bg-gray-400 rounded-full peer-focus:ring-4 peer-focus:ring-blue-300
              peer-checked:bg-blue-600 after:content-[''] after:absolute after:top-[2px]
              after:left-[2px] after:bg-white after:border after:rounded-full after:h-5
              after:w-5 after:transition-all peer-checked:after:translate-x-full
            "></div>
          <span class="ml-3 text-sm font-medium">
            Enable Spaced Repetition
          </span>
        </label>
        <p
          class="
            <%= @user_deck.use_space_repetition? ? "flex" : "hidden" %> items-center text-xs text-orange-500
          ">Warning: Disabling Spaced Repetition will reset progress at start of
          review.</p>
      </details>
      <% if @user_deck.use_space_repetition? %>
        <% if @due_for_review_count.positive? %>
          <p class="flex mb-2 text-sm" data-decks--review-settings-target="nextReviewMsg">
            You have
            <span class="px-1 text-orange-500">(<%= pluralize(@due_for_review_count, "card") %>)</span>
            due for review today.
          </p>
        <% else %>
          <p class="flex mb-2 text-sm" data-decks--review-settings-target="nextReviewMsg">
            No cards due for review. Next review on
            <span class="px-1 text-green-500">
              (<%= @user_deck.next_review_date.strftime("%B %d, %Y") %>)
            </span>
          </p>
        <% end %>
      <% end %>
      <div class="flex gap-2" data-controller="modal">
        <%= f.button type: :submit,
            class: "flex items-center justify-center btn btn-primary rounded disabled:border disabled:bg-transparent disabled:cursor-not-allowed disabled:border-gray-700 disabled:text-gray-700",
            disabled: study_button_disabled?(@user_deck, @due_for_review_count),
            data: {
              "decks--review-settings-target" => "submitBtn",
            } do %>
          <%= render_icon("play_circle", klass: "size-5 mr-1") %>
          Study
        <% end %>
        <%= button_tag(
              type: "button",
              class: "flex items-center justify-center btn btn-success rounded",
              command: "show-modal",
              commandfor: "study-plans-dialog"
            ) do %>
          <%= render_icon("plus", klass: "size-5 mr-1") %>
          <%= t("buttons.study_plan_decks.create") %>
        <% end %>
      </div>
    <% end %>
    <%= render "shared/study_plans/modal", object: @deck %>
  </div>
</div>
