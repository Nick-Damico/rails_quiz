<div class="max-w-3xl mx-auto px-4 py-8">
  <div class="mb-8">
    <%= link_to "← Decks", admin_dashboard_path(tab: "decks"),
                class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
    <h1 class="mt-4 text-3xl font-bold text-gray-300">
      Edit Deck
    </h1>
    <p class="mt-2 text-sm text-gray-400">
      Manage <%= @deck.title %>
    </p>
  </div>
  <div class="border border-white rounded-lg shadow-sm">
    <%= form_with model: [  :admin, @deck  ], class: "p-6 space-y-6" do |form| %>
      <div class="mb-4 field">
        <%= form.label :title,
                       class: "text-white text-xs font-semibold uppercase mb-2" %>
        <%= form.text_field :title,
                            class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:bg-white focus:outline-none focus:shadow-outline" %>
        <%= display_field_error(@deck, :title) %>
      </div>
      <div class="mb-4 field">
        <%= form.label :description,
                       class: "text-white text-xs font-semibold uppercase mb-2" %>
        <%= form.text_field :description,
                            class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:bg-white focus:outline-none focus:shadow-outline" %>
        <%= display_field_error(@deck, :description) %>
      </div>
      <div class="border-t border-gray-200 pt-6">
        <h2 class="text-base font-semibold text-white">
          Deck Info
        </h2>
        <div class="mb-4 field">
          <%= form.label :hidden, "Deactivate Deck",
                             class: "text-white text-xs font-semibold uppercase mb-2" %>
          <%= form.check_box :hidden,
                           class: "mr-2 leading-tight" %>
          <span class="text-sm text-gray-300">
            Hides and Unpublishes Deck from public view
          </span>
        </div>
      </div>
      <div class="flex items-center justify-end gap-3 border-t border-gray-200 pt-6">
        <%= link_to "Cancel",
                    admin_dashboard_path(tab: "decks"),
                    class: "rounded-md px-4 py-2 text-sm font-medium text-white hover:bg-warning hover:text-gray-700" %>
        <%= form.submit "Save changes",
                        class: "btn btn-primary text-sm font-medium rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
      </div>
    <% end %>
  </div>
</div>
