<h1 class="text-2xl font-semibold mb-1">Admin Dashboard</h1>
<p class="text-sm text-gray-500 dark:text-gray-400 mb-8">
  Manage users, quizzes, and decks.
</p>
<section aria-labelledby="resource-heading">
  <%= turbo_frame_tag :table_content do %>
    <%= render "shared/category_filters", path: @path, open_status: false unless @tab.downcase == "user" %>
    <%= render "search", path: @path %>
    <%= render "navigation" %>
    <div>
      <%= render @tab.downcase, objects: @objects %>
      <%= render "shared/pagy" %>
    </div>
  <% end %>
</section>
