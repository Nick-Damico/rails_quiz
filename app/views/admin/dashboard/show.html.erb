<h1 class="text-2xl mb-6">Welcome Admin!</h1>
<section>
  <h2 class="text-xl mb-4">Manage</h2>
  <nav class="border-y border-gray-200 dark:border-gray-700 mb-4" aria-label="Resource Types">
    <ul class="flex -mb-px text-sm font-medium">
      <li>
        <%= link_to "Users",
            public_profile_user_path(@user, tab: :user),
            class: public_profile_tab_classes(@tab, "user"), data: { turbo: false } %>
      </li>
      <li>
        <%= link_to "Quizzes",
            public_profile_user_path(@user, tab: :quiz),
            class: public_profile_tab_classes(@tab, "quiz"), data: { turbo: false } %>
      </li>
      <li>
        <%= link_to "Decks",
            public_profile_user_path(@user, tab: :deck),
            class: public_profile_tab_classes(@tab, "deck"), data: { turbo: false } %>
      </li>
    </ul>
  </nav>
  <div>
    <div class="relative overflow-x-auto">
      <table class="w-full text-sm text-left text-gray-500 rtl:text-right dark:text-gray-400">
        <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
          <tr>
            <%= %>
            <th scope="col" class="px-3 py-3">
              Title
            </th>
            <th scope="col" class="px-3 py-3">
              Description
            </th>
            <th scope="col" class="px-3 py-3">
              Created On
            </th>
            <th scope="col" class="px-3 py-3 text-right">
              Actions
            </th>
          </tr>
        </thead>
        <tbody>
          <% @objects.each do |object| %>
            <%= render "admin/dashboard/object_line_item", object: object, show_path: polymorphic_path(object) %>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/pagy" %>
  </div>
</section>
