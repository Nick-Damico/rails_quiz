<%= render "shared/modal_wrapper", modal_id: "study-plans-dialog" do %>
  <div class="flex items-center justify-between px-5 py-4 border-b border-slate-200">
    <h2 class="text-lg font-semibold">Select a Study Plan</h2>
    <div>
      <%= button_tag(
            type: "button",
            aria_label: "Close dialog",
            class: "btn btn-primary rounded-md",
            command: "close",
            commandfor: "study-plans-dialog"
          ) do %>
        <span aria-hidden="true text-xl">&times;</span>
      <% end %>
    </div>
  </div>
  <div class="px-5">
    <label for="category-search" class="sr-only">
      Search Study Plans
    </label>
    <!--<input id="study-plans-search" type="search" placeholder="Search..." autocomplete="off" class="w-full px-3 py-2 text-sm border rounded-md border-slate-300 placeholder:text-slate-400">-->
  </div>
  <%= form_with model: model_for_modal(object), url: url_for_modal(object), method: :post, class: "flex flex-col justify-end" do |f| %>
    <%= hidden_field_for_modal(f, object) %>
    <ul class="flex flex-col gap-2 p-2 overflow-y-auto max-h-96">
      <% if @study_plans.any? %>
        <%= f.collection_radio_buttons :study_plan_id, @study_plans, :id, :name do |r_b| %>
          <div>
            <% disabled = modal_radio_btn_disabled?(r_b, object) %>
            <%= r_b.radio_button class: "sr-only peer", disabled: disabled %>
            <%= r_b.label class:
              "flex w-full px-3 py-3 text-sm text-left border border-gray-600 rounded-md cursor-pointer
               peer-checked:bg-blue-500 group hover:bg-blue-500 focus:bg-blue-500 focus:outline-none peer-disabled:text-gray-400
               peer-disabled:cursor-not-allowed peer-disabled:bg-transparent peer-disabled:after:block peer-disabled:after:ml-auto
               peer-disabled:after:text-red-500 peer-disabled:after:content-['Already-added']" %>
          </div>
        <% end %>
      <% else %>
        <li class="px-3 py-2 text-sm text-gray-500">No study plans found.</li>
      <% end %>
    </ul>
    <div class="flex justify-end gap-2 py-4 border-t border-gray-700">
      <%= button_tag(
          "Cancel",
          class: "btn btn-warning",
          type: "button",
          command: "close",
          commandfor: "study-plans-dialog"
          ) %>
      <%= f.submit t("buttons.study_plan_decks.create"), class: "btn btn-success mr-6" %>
    </div>
  <% end %>
<% end %>
