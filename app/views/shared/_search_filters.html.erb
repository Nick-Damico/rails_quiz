<details class="pb-4 mb-4 border-b border-gray-800" open>
  <summary class="text-xl mb-4">Category Filters</summary>
  <%= form_with url: author_decks_path, class: "flex flex-col" do |form| %>
    <div class="grid grid-cols-3 gap-1 md:grid-cols-9">
      <% @filter_objects[:categories].each.with_index(1) do |category, index| %>
        <%= form.label "category_ids_#{index}", class: "relative py-4 duration-300 ease-in-out border border-gray-800 hover:border-blue-800 has-[:checked]:bg-blue-800 cursor-pointer" do %>
          <%= form.check_box :category_ids, value: category.id, multiple: true, id: "category_ids_#{index}", class: "sr-only" %>
          <span class="relative flex items-center justify-center w-full h-full text-center "><%= category.name %></span>
        <% end %>
      <% end %>
    </div>
    <%= form.submit "filter", class: "mt-2 text-center btn-border-only text-white font-semibold uppercase py-2 px-4 rounded focus:outline-none focus:shadow-outline actions cursor-pointer justify-self-end" %>
  <% end %>
</details>