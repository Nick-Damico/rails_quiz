<div data-controller="pop-up-menu" class="relative">
  <button class="flex items-center rounded" data-action="click->pop-up-menu#displayMenu">
    <%= render_icon "three_dots_horizontal", klass: "size-5" %>
  </button>
  <nav data-pop-up-menu-target="menu" class="hidden absolute w-1/2 p-1 bg-blue-400 rounded-sm left-2 top-6" aria-label="Card menu">
    <ul class="flex flex-col">
      <% if policy([ :author, object.deck ]).edit? %>
        <li class="flex px-2 py-1 hover:bg-blue-500">
          <%= link_to edit_author_deck_path(object), class: "flex grow transition duration-500" do %>
            <span class="flex w-6 text-left" aria-label="Edit card">
              <%= render_icon "pencil", klass: "size-5" %>
            </span>
            <span class="ml-1 text-sm grow">edit</span>
          <% end %>
        </li>
      <% end %>
      <li class="flex px-2 py-1 hover:bg-blue-500">
        <%= button_to study_plan_deck_path(object), class: "flex grow", method: :delete, aria: { label: "Remove Deck" } do %>
          <span class="flex w-6 text-left">
            <%= render_icon "x_circle", klass: "text-left size-5" %>
          </span>
          <span class="ml-1 text-sm grow">remove</span>
        <% end %>
      </li>
    </ul>
  </nav>
</div>